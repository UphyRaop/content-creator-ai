# Future provider integrations only. Prototype mode makes no external requests.
# Never place real credentials in this file or commit secrets.
CCAI_SCRIPT_PROVIDER=simulated
CCAI_ENABLE_LIVE_AI=false
CCAI_LIVE_AI_APPROVED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional current billing rates, Malaysian Ringgit per 1 million tokens.
GEMINI_INPUT_MYR_PER_MILLION=
GEMINI_OUTPUT_MYR_PER_MILLION=
FLUX_API_KEY=
CCAI_IMAGE_PROVIDER=simulated
CCAI_ENABLE_LIVE_IMAGES=false
CCAI_LIVE_IMAGES_APPROVED=false
# Set only after separate user approval. MYR per image; omit to block live generation.
CCAI_FLUX_PRICE_MYR_PER_IMAGE=
# Voice output is simulated. Do not enable live API calls without separate approval.
CCAI_VOICE_PROVIDER=simulated
CCAI_ENABLE_LIVE_VOICE=false
CCAI_LIVE_VOICE_APPROVED=false
ELEVENLABS_MODEL=eleven_multilingual_v2
# The server vault encrypts multiple authorized account keys in SQLite. Supply a random
# 32-byte base64 encryption key and a separate admin token only in a private server environment.
CCAI_VOICE_VAULT_ENCRYPTION_KEY=
CCAI_VOICE_VAULT_ADMIN_TOKEN=
# Live calls remain blocked when credit/MYR rates are unknown.
CCAI_ELEVENLABS_CREDITS_PER_CHARACTER=
CCAI_ELEVENLABS_MYR_PER_1000_CREDITS=
